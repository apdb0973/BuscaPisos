"""Inmovilla scraper: Playwright navigation + in-memory DOM parsing (bs4)."""

from __future__ import annotations

from dataclasses import dataclass

from bs4 import BeautifulSoup, Tag
from playwright.async_api import Page, TimeoutError as PlaywrightTimeoutError

from buscapisos.models import Listing
from buscapisos.parsing import parse_area, parse_int, parse_price
from buscapisos.repository import ListingRepository


# ---------------------------------------------------------------------------
# Domain exceptions
# ---------------------------------------------------------------------------
class ScraperError(Exception):
    """Base class for all scraper failures."""


class ScraperTimeoutError(ScraperError):
    """Raised when Playwright navigation times out."""


class SelectorNotFoundError(ScraperError):
    """Raised when a required DOM selector is missing."""


class MissingFieldError(ScraperError):
    """Raised when a required node is present but empty."""


# ---------------------------------------------------------------------------
# Selectors (injectable: Inmovilla is a white-label engine, so the concrete
# CSS hooks vary per agency).
# ---------------------------------------------------------------------------
@dataclass(frozen=True)
class InmovillaSelectors:
    title: str = ".listing-title"
    price: str = ".listing-price"
    area: str = ".listing-area"
    bedrooms: str = ".listing-bedrooms"
    bathrooms: str = ".listing-bathrooms"
    source_id: str = ".listing-ref"
    source_id_attr: str = "data-ref"


class InmovillaScraper:
    """Navigates to a listing page and parses its DOM into a Listing.

    Navigation (Playwright) and DOM parsing (bs4) are strictly separated so the
    parser can be unit-tested against HTML fixtures without any network I/O.
    """

    def __init__(
        self,
        selectors: InmovillaSelectors | None = None,
        timeout_ms: int = 30_000,
    ) -> None:
        self.selectors = selectors or InmovillaSelectors()
        self.timeout_ms = timeout_ms

    # -- Pure DOM parsing (no I/O) -------------------------------------------
    def parse_listing(self, html: str, url: str) -> Listing:
        soup = BeautifulSoup(html, "lxml")

        title = self._text(soup, self.selectors.title)
        price = parse_price(self._text(soup, self.selectors.price))
        area = parse_area(self._text(soup, self.selectors.area))
        bedrooms = parse_int(self._text(soup, self.selectors.bedrooms))
        bathrooms = parse_int(self._text(soup, self.selectors.bathrooms))
        source_id = self._attr(soup, self.selectors.source_id, self.selectors.source_id_attr)

        return Listing(
            title=title,
            price=price,
            area=area,
            bedrooms=bedrooms,
            bathrooms=bathrooms,
            url=url,
            source_id=source_id,
            source="inmovilla",
        )

    # -- Network navigation (Playwright) -------------------------------------
    async def scrape_listing(self, page: Page, url: str) -> Listing:
        try:
            await page.goto(url, wait_until="domcontentloaded", timeout=self.timeout_ms)
        except PlaywrightTimeoutError as exc:
            raise ScraperTimeoutError(f"timeout navigating to {url}") from exc

        html = await page.content()
        return self.parse_listing(html, url)

    # -- Internal helpers ----------------------------------------------------
    def _select_one(self, soup: BeautifulSoup, selector: str) -> Tag:
        node = soup.select_one(selector)
        if node is None:
            raise SelectorNotFoundError(f"selector {selector!r} not found")
        return node

    def _text(self, soup: BeautifulSoup, selector: str) -> str:
        node = self._select_one(soup, selector)
        text = node.get_text(" ", strip=True)
        if not text:
            raise MissingFieldError(f"selector {selector!r} produced empty text")
        return text

    def _attr(self, soup: BeautifulSoup, selector: str, attribute: str) -> str:
        node = self._select_one(soup, selector)
        value = node.get(attribute) or node.get_text(" ", strip=True)
        if not value:
            raise MissingFieldError(f"selector {selector!r} has no attribute {attribute!r}")
        return value


class InmovillaIngestor:
    """Orchestrates scraper -> repository while keeping both decoupled."""

    def __init__(self, scraper: InmovillaScraper, repository: ListingRepository) -> None:
        self.scraper = scraper
        self.repository = repository

    async def ingest_html(self, html: str, url: str) -> Listing:
        listing = self.scraper.parse_listing(html, url)
        await self.repository.add(listing)
        return listing

    async def ingest_url(self, page: Page, url: str) -> Listing:
        listing = await self.scraper.scrape_listing(page, url)
        await self.repository.add(listing)
        return listing
</file>

<file path="supabase/migrations/0001_core_schema.sql">
-- =============================================================================
-- 0001_core_schema.sql
-- Core relational schema for the Gran Canaria real-estate aggregator.
--
-- Creates:
--   * Extensions (PostGIS for Catastro X,Y coordinates, pgcrypto for UUIDs)
--   * properties    -- the unique, deduplicated physical property
--   * listings      -- raw scraped ads (Inmovilla, Idealista, BOE, ...)
--   * price_history -- price-variation tracking (1:N with listings)
--   * PL/pgSQL functions + triggers for automatic last_seen maintenance
--   * Row Level Security (RLS) policies + grants
--
-- Design notes:
--   * last_seen uses clock_timestamp() (not now()) so every scraper detection
--     gets a fresh timestamp even within a single transaction. now() is
--     transaction-stable and would NOT advance inside one transaction, which
--     is exactly what the pgTAP trigger test depends on.
--   * Grants follow Supabase's model: table privileges are broad, RLS does the
--     real gating. anon has table privileges but only SELECT policies (and no
--     INSERT/UPDATE/DELETE policies), so its writes are rejected by RLS.
-- =============================================================================

-- ---------------------------------------------------------------------------
-- Extensions
-- ---------------------------------------------------------------------------
CREATE EXTENSION IF NOT EXISTS postgis;
CREATE EXTENSION IF NOT EXISTS pgcrypto;  -- gen_random_uuid()

-- ---------------------------------------------------------------------------
-- Roles (Supabase already provides anon / authenticated / service_role; these
-- guarded blocks only make the migration runnable on a bare Postgres for pgTAP).
-- ---------------------------------------------------------------------------
DO $$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'anon') THEN
        CREATE ROLE anon NOLOGIN;
    END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'authenticated') THEN
        CREATE ROLE authenticated NOLOGIN;
    END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'service_role') THEN
        CREATE ROLE service_role NOLOGIN BYPASSRLS;
    END IF;
END
$$;

-- ---------------------------------------------------------------------------
-- properties: the unique physical property (deduplicated entity)
-- ---------------------------------------------------------------------------
CREATE TABLE public.properties (
    id                   uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    created_at           timestamptz NOT NULL DEFAULT now(),
    updated_at           timestamptz NOT NULL DEFAULT now(),
    last_seen            timestamptz,
    property_type        text NOT NULL
                         CHECK (property_type IN
                            ('house','apartment','commercial','land','garage','other')),
    title                text,
    location             geometry(Point, 4326),   -- Catastro X,Y (EPSG:4326)
    address              text,
    city                 text,
    province             text,
    postal_code          text,
    cru                  text UNIQUE,              -- Código Registral Único
    referencia_catastral text UNIQUE,              -- Referencia Catastral
    area                 numeric(10,2),            -- built m2
    bedrooms             integer,
    bathrooms            integer,
    is_public            boolean NOT NULL DEFAULT false
);

CREATE INDEX idx_properties_location_gist ON public.properties USING GIST (location);

-- ---------------------------------------------------------------------------
-- listings: raw scraped ads (Inmovilla, Idealista, BOE, ...)
-- ---------------------------------------------------------------------------
CREATE TABLE public.listings (
    id            uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    property_id   uuid NOT NULL REFERENCES public.properties(id) ON DELETE RESTRICT,
    source        text NOT NULL
                  CHECK (source IN ('inmovilla','idealista','boe','other')),
    source_id     text NOT NULL,
    url           text,
    title         text,
    description   text,
    price         numeric(12,2),
    currency      char(3) NOT NULL DEFAULT 'EUR',
    area          numeric(10,2),
    bedrooms      integer,
    bathrooms     integer,
    status        text NOT NULL DEFAULT 'active'
                  CHECK (status IN ('active','inactive','sold','rented','removed')),
    location      geometry(Point, 4326),           -- optional source coordinates
    first_seen    timestamptz NOT NULL DEFAULT now(),
    last_seen     timestamptz NOT NULL DEFAULT now(),
    created_at    timestamptz NOT NULL DEFAULT now(),
    updated_at    timestamptz NOT NULL DEFAULT now(),
    CONSTRAINT listings_source_source_id_key UNIQUE (source, source_id)
);

CREATE INDEX idx_listings_property_id    ON public.listings (property_id);
CREATE INDEX idx_listings_location_gist  ON public.listings USING GIST (location);
CREATE INDEX idx_listings_source         ON public.listings (source);

-- ---------------------------------------------------------------------------
-- price_history: price variations per listing (1:N with listings)
-- ---------------------------------------------------------------------------
CREATE TABLE public.price_history (
    id          uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    listing_id  uuid NOT NULL REFERENCES public.listings(id) ON DELETE CASCADE,
    price       numeric(12,2) NOT NULL,
    currency    char(3) NOT NULL DEFAULT 'EUR',
    observed_at timestamptz NOT NULL DEFAULT now(),
    source      text,
    created_at  timestamptz NOT NULL DEFAULT now()
);

CREATE INDEX idx_price_history_listing_id
    ON public.price_history (listing_id, observed_at DESC);

-- =============================================================================
-- Triggers: automatic last_seen maintenance
-- =============================================================================

-- (1) Every INSERT/UPDATE on a listing marks it as "just seen" by the scraper.
CREATE OR REPLACE FUNCTION public.fn_listings_set_last_seen()
RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
    NEW.last_seen := clock_timestamp();
    RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_listings_set_last_seen ON public.listings;
CREATE TRIGGER trg_listings_set_last_seen
BEFORE INSERT OR UPDATE ON public.listings
FOR EACH ROW EXECUTE FUNCTION public.fn_listings_set_last_seen();

-- (2) Keep the parent property's last_seen in sync with its listings.
CREATE OR REPLACE FUNCTION public.fn_sync_property_last_seen()
RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
    UPDATE public.properties
       SET last_seen = NEW.last_seen
     WHERE id = NEW.property_id;
    RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_sync_property_last_seen ON public.listings;
CREATE TRIGGER trg_sync_property_last_seen
AFTER INSERT OR UPDATE ON public.listings
FOR EACH ROW EXECUTE FUNCTION public.fn_sync_property_last_seen();

-- (3) A new price observation also refreshes the listing (and, in turn, the
--     property via the triggers above).
CREATE OR REPLACE FUNCTION public.fn_sync_last_seen_from_price()
RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
    UPDATE public.listings
       SET last_seen = clock_timestamp()
     WHERE id = NEW.listing_id;
    RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_sync_last_seen_from_price ON public.price_history;
CREATE TRIGGER trg_sync_last_seen_from_price
AFTER INSERT ON public.price_history
FOR EACH ROW EXECUTE FUNCTION public.fn_sync_last_seen_from_price();

-- (4) Keep updated_at fresh on properties and listings.
CREATE OR REPLACE FUNCTION public.fn_touch_updated_at()
RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
    NEW.updated_at := clock_timestamp();
    RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_properties_touch_updated_at ON public.properties;
CREATE TRIGGER trg_properties_touch_updated_at
BEFORE UPDATE ON public.properties
FOR EACH ROW EXECUTE FUNCTION public.fn_touch_updated_at();

DROP TRIGGER IF EXISTS trg_listings_touch_updated_at ON public.listings;
CREATE TRIGGER trg_listings_touch_updated_at
BEFORE UPDATE ON public.listings
FOR EACH ROW EXECUTE FUNCTION public.fn_touch_updated_at();

-- =============================================================================
-- Row Level Security
-- =============================================================================

ALTER TABLE public.properties    ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.listings      ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.price_history ENABLE ROW LEVEL SECURITY;

GRANT USAGE ON SCHEMA public TO anon, authenticated, service_role;

GRANT SELECT, INSERT, UPDATE, DELETE
    ON public.properties, public.listings, public.price_history
    TO anon, authenticated, service_role;

-- anon: read-only access to public data (no INSERT/UPDATE/DELETE policies).
CREATE POLICY "anon_select_public_properties" ON public.properties
    FOR SELECT TO anon
    USING (is_public = true);

CREATE POLICY "anon_select_public_listings" ON public.listings
    FOR SELECT TO anon
    USING (
        EXISTS (
            SELECT 1
              FROM public.properties p
             WHERE p.id = property_id
               AND p.is_public = true
        )
    );

CREATE POLICY "anon_select_public_price_history" ON public.price_history
    FOR SELECT TO anon
    USING (
        EXISTS (
            SELECT 1
              FROM public.listings l
              JOIN public.properties p ON p.id = l.property_id
             WHERE l.id = listing_id
               AND p.is_public = true
        )
    );

-- authenticated / service_role: full access (the scraper runs as service_role,
-- which also bypasses RLS via BYPASSRLS).
CREATE POLICY "authenticated_all_properties" ON public.properties
    FOR ALL TO authenticated, service_role
    USING (true) WITH CHECK (true);

CREATE POLICY "authenticated_all_listings" ON public.listings
    FOR ALL TO authenticated, service_role
    USING (true) WITH CHECK (true);

CREATE POLICY "authenticated_all_price_history" ON public.price_history
    FOR ALL TO authenticated, service_role
    USING (true) WITH CHECK (true);
</file>

<file path="supabase/tests/001_core_schema.test.sql">
-- =============================================================================
-- 001_core_schema.test.sql
-- pgTAP unit tests for the core schema: properties, listings, price_history.
--
-- Run with:  supabase test db
--            (or standalone:  pg_prove -d <db> supabase/tests/001_core_schema.test.sql)
--
-- Notes:
--   * pgTAP is provided by Supabase's test runner; PostGIS and the schema are
--     created by supabase/migrations/0001_core_schema.sql, which must run first.
--   * These tests exercise (a) table existence, (b) UUID primary keys and data
--     types, (c) foreign-key integrity (no orphan listings), (d) the last_seen
--     triggers, (e) ON DELETE CASCADE, and (f) RLS blocking of anon INSERTs.
-- =============================================================================

BEGIN;

SELECT plan(25);

-- ---------------------------------------------------------------------------
-- 1. The three core tables must exist
-- ---------------------------------------------------------------------------
SELECT has_table('public', 'properties',    'table properties exists');
SELECT has_table('public', 'listings',      'table listings exists');
SELECT has_table('public', 'price_history', 'table price_history exists');

-- ---------------------------------------------------------------------------
-- 2. UUID primary keys
-- ---------------------------------------------------------------------------
SELECT col_is_pk('public', 'properties',     'id', 'properties.id is the primary key');
SELECT col_type_is('public', 'properties',   'id', 'uuid', 'properties.id is uuid');
SELECT col_is_pk('public', 'listings',       'id', 'listings.id is the primary key');
SELECT col_type_is('public', 'listings',     'id', 'uuid', 'listings.id is uuid');
SELECT col_is_pk('public', 'price_history',  'id', 'price_history.id is the primary key');
SELECT col_type_is('public', 'price_history','id', 'uuid', 'price_history.id is uuid');

-- ---------------------------------------------------------------------------
-- 3. Key columns and data types (PostGIS geometry + numeric)
-- ---------------------------------------------------------------------------
SELECT has_column('public', 'listings', 'property_id', 'listings has property_id');

SELECT col_type_is(
    'public', 'properties', 'location',
    'geometry(Point,4326)',
    'properties.location is geometry(Point,4326)'
);

SELECT ok(
    (SELECT data_type = 'numeric'
       FROM information_schema.columns
      WHERE table_schema = 'public' AND table_name = 'listings' AND column_name = 'price'),
    'listings.price is numeric'
);

SELECT ok(
    (SELECT data_type = 'numeric'
       FROM information_schema.columns
      WHERE table_schema = 'public' AND table_name = 'listings' AND column_name = 'area'),
    'listings.area is numeric'
);

SELECT ok(
    (SELECT data_type = 'numeric'
       FROM information_schema.columns
      WHERE table_schema = 'public' AND table_name = 'price_history' AND column_name = 'price'),
    'price_history.price is numeric'
);

-- ---------------------------------------------------------------------------
-- 4. Foreign keys: no orphan listings / price rows
-- ---------------------------------------------------------------------------
SELECT fk_ok(
    'public', 'listings', 'property_id',
    'public', 'properties', 'id',
    'listings.property_id -> properties.id'
);

SELECT fk_ok(
    'public', 'price_history', 'listing_id',
    'public', 'listings', 'id',
    'price_history.listing_id -> listings.id'
);

-- Inserting a listing whose property does not exist must fail (SQLSTATE 23503).
SELECT throws_ok(
    $$ INSERT INTO public.listings (property_id, source, source_id)
       VALUES ('00000000-0000-0000-0000-000000000000', 'inmovilla', 'orphan-1') $$,
    '23503',
    'orphan listing is rejected by the foreign key'
);

-- ---------------------------------------------------------------------------
-- 5. Trigger: listings.last_seen (and properties.last_seen) maintained
--    automatically on INSERT and UPDATE.
-- ---------------------------------------------------------------------------
-- Seed one public property and one listing, capturing their ids / last_seen.
CREATE TEMP TABLE _test_property AS
WITH ins AS (
    INSERT INTO public.properties (property_type, location, is_public)
    VALUES ('apartment', ST_SetSRID(ST_MakePoint(-15.42, 28.10), 4326), true)
    RETURNING id
)
SELECT id FROM ins;

CREATE TEMP TABLE _test_listing AS
WITH ins AS (
    INSERT INTO public.listings (property_id, source, source_id, price, area)
    SELECT id, 'inmovilla', 'ext-trigger-1', 250000, 80 FROM _test_property
    RETURNING id, last_seen
)
SELECT id, last_seen FROM ins;

SELECT is(
    (SELECT last_seen IS NOT NULL FROM _test_listing),
    true,
    'listings.last_seen is set automatically on INSERT'
);

-- Let time advance so clock_timestamp() yields a strictly newer value.
SELECT pg_sleep(0.1);

UPDATE public.listings
   SET price = price + 1
 WHERE id = (SELECT id FROM _test_listing);

SELECT isnt(
    (SELECT last_seen FROM public.listings WHERE id = (SELECT id FROM _test_listing)),
    (SELECT last_seen FROM _test_listing),
    'listings.last_seen changes automatically on UPDATE'
);

SELECT is(
    (SELECT last_seen FROM public.properties WHERE id = (SELECT id FROM _test_property)),
    (SELECT last_seen FROM public.listings  WHERE id = (SELECT id FROM _test_listing)),
    'properties.last_seen is synced from its listing'
);

-- ---------------------------------------------------------------------------
-- 6. ON DELETE CASCADE: listings -> price_history
-- ---------------------------------------------------------------------------
INSERT INTO public.price_history (listing_id, price)
VALUES ((SELECT id FROM _test_listing), 250000);

SELECT lives_ok(
    $$ DELETE FROM public.listings WHERE id = (SELECT id FROM _test_listing) $$,
    'deleting a listing succeeds'
);

SELECT is(
    (SELECT count(*) FROM public.price_history WHERE listing_id = (SELECT id FROM _test_listing)),
    0,
    'price_history rows are cascade-deleted with their listing'
);

-- ---------------------------------------------------------------------------
-- 7. RLS: the anon role must NOT be able to INSERT
-- ---------------------------------------------------------------------------
SET LOCAL ROLE anon;

SELECT throws_ok(
    $$ INSERT INTO public.properties (property_type, is_public)
       VALUES ('apartment', true) $$,
    '42501',
    'anon INSERT into properties is blocked by RLS'
);

SELECT throws_ok(
    $$ INSERT INTO public.listings (property_id, source, source_id)
       VALUES ('00000000-0000-0000-0000-000000000000', 'inmovilla', 'anon-1') $$,
    '42501',
    'anon INSERT into listings is blocked by RLS'
);

SELECT throws_ok(
    $$ INSERT INTO public.price_history (listing_id, price)
       VALUES ('00000000-0000-0000-0000-000000000000', 100) $$,
    '42501',
    'anon INSERT into price_history is blocked by RLS'
);

RESET ROLE;

-- ---------------------------------------------------------------------------
SELECT * FROM finish();

ROLLBACK;
</file>

